# ─────────────────────────────────────────────────────────────────────────────
# .env.example: copy this to .env and change what you need.
# NEVER commit .env to Git; it can hold real credentials.
#
# Every value below points at the public practice sites the suite is written
# for, so a fresh copy works as-is. Read by config/environments.py and conftest.py.
# ─────────────────────────────────────────────────────────────────────────────

# Default environment for config.get_config(). Tests pick theirs with:
#   pytest --env=staging        (staging | dev | prod)
ENV=staging

# Site under test and API per environment
DEV_URL=https://the-internet.herokuapp.com
DEV_API_URL=https://jsonplaceholder.typicode.com
STAGING_URL=https://the-internet.herokuapp.com
STAGING_API_URL=https://jsonplaceholder.typicode.com
PROD_URL=https://the-internet.herokuapp.com
PROD_API_URL=https://jsonplaceholder.typicode.com

# Login per environment (the public demo account shown on the-internet's login page)
DEV_USERNAME=tomsmith
DEV_PASSWORD=SuperSecretPassword!
TEST_USERNAME=tomsmith
TEST_PASSWORD=SuperSecretPassword!
PROD_USERNAME=tomsmith
PROD_PASSWORD=SuperSecretPassword!

# Set to 1 to record a video of each test into reports/videos/
RECORD_VIDEO=

# Browser and headless mode are pytest options, not settings here:
#   pytest --browser-type=firefox --headless=false
